# Copy to .env and adjust. Never commit the real .env (it is git-ignored).

# --- Databases (compose injects MAIN_DATABASE_URL into services directly) ---
MAIN_DB_PASSWORD=sentinel
SANDBOX_DB_PASSWORD=sandbox

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO

# --- Agent leash defaults (ADR-011). Seed values; the settings table overrides. ---
MAX_AGENT_STEPS=15
MAX_ACTIVE_REQUESTS=30
LLM_STEP_TIMEOUT_SECONDS=60
TOOL_STEP_TIMEOUT_SECONDS=30

# --- Local posture (ADR-007) ---
ALLOWED_ORIGIN=http://127.0.0.1:8000

# --- LLM gateway (used in step 3; no value needed yet) ---
# CLAUDE_CODE_TOKEN=
