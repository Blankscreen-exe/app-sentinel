# Copy to .env and adjust. Never commit the real .env (it is git-ignored).

# --- Databases (compose injects MAIN_DATABASE_URL into services directly) ---
MAIN_DB_PASSWORD=sentinel
SANDBOX_DB_PASSWORD=sandbox

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO

# --- Agent leash defaults (ADR-011). Seed values; the settings table overrides. ---
MAX_AGENT_STEPS=15
MAX_ACTIVE_REQUESTS=30
LLM_STEP_TIMEOUT_SECONDS=60
TOOL_STEP_TIMEOUT_SECONDS=30

# --- Local posture (ADR-007) ---
ALLOWED_ORIGIN=http://127.0.0.1:8000

# --- LLM gateway (used in step 3; no value needed yet) ---
# CLAUDE_CODE_TOKEN=

# --- Host user for bind-mount ownership (Linux). Match `id -u` / `id -g`. ---
HOST_UID=1000
HOST_GID=1000

# --- Artifact storage + upload limits (ADR-004c) ---
DATA_DIR=/data
MAX_UPLOAD_BYTES=314572800
MAX_UNCOMPRESSED_BYTES=2147483648
MAX_ZIP_ENTRIES=100000

# --- LLM (agent) ---
# LLM_MODE: disabled (no agent) | stub (deterministic, tests) | gateway (real Claude)
LLM_MODE=disabled
LLM_MODEL=sonnet
# Absolute path to the operator's Claude config, mounted read-only into the gateway
# ONLY (ADR-015). Required when LLM_MODE=gateway. Example:
# HOST_CLAUDE_DIR=/home/youruser/.claude
HOST_CLAUDE_DIR=/nonexistent

# Gateway auth (set ONE when LLM_MODE=gateway; injected into the gateway only):
# CLAUDE_CODE_OAUTH_TOKEN=    # from: claude setup-token
# ANTHROPIC_API_KEY=          # or a standard Anthropic API key
